#!/usr/bin/env sh

pnpm lint-staged

pnpm test

# Non-blocking Impeccable design QA report on staged UI files.
DETECT_SCRIPT="$HOME/.claude/plugins/cache/impeccable/impeccable/4.0.4/skills/impeccable/scripts/detect.mjs"
if [ -f "$DETECT_SCRIPT" ]; then
  STAGED_UI_FILES=$(git diff --cached --name-only --diff-filter=ACM -- '*.tsx' '*.jsx' '*.ts' '*.js' '*.css' '*.scss' '*.html')
  if [ -n "$STAGED_UI_FILES" ]; then
    node "$DETECT_SCRIPT" --json $STAGED_UI_FILES 2>/dev/null | node scripts/format-ui-report.mjs >UI_REPORT.md || true
  fi
fi