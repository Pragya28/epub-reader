#!/usr/bin/env sh

# Keep the local (gitignored) code-review graph in sync. Incremental, so it
# is cheap; never blocks or fails the git operation, and is a no-op where
# code-review-graph isn't installed.
command -v code-review-graph >/dev/null 2>&1 || exit 0
code-review-graph update >/dev/null 2>&1 || true
